# DEPTH=1 bundled-data mailbox constraints. The single broad pattern also
# matches the preserved wrapper hierarchy bridge/single/impl/... . Keep this
# file for old bridge or DEPTH1 only; DEPTH4 uses ddr_queue4_cdc.fdc instead.
# Do not cut asynchronous clock groups: payload flight time must remain bounded.
set_max_delay 8.0 -datapath_only -from [get_cells -hierarchical {bridge/*hold_*}] -to [get_clocks ddrphy_sysclk]
set_max_delay 8.0 -datapath_only -from [get_cells -hierarchical {bridge/*return_*}] -to [get_clocks cpu_clk]
set_false_path -hold -from [get_clocks cpu_clk] -to [get_clocks ddrphy_sysclk]
set_false_path -hold -from [get_clocks ddrphy_sysclk] -to [get_clocks cpu_clk]
# Select from the SOURCE clock, so same-domain synchronizer stage-to-stage
# paths remain timed even though both register bits match the name pattern.
set_false_path -from [get_clocks cpu_clk] -to [get_cells -hierarchical {bridge/*req_sync*}]
set_false_path -from [get_clocks ddrphy_sysclk] -to [get_cells -hierarchical {bridge/*ack_sync* bridge/*init_sync* bridge/*fault_sync*}]
# Common asynchronous controller+CPU/UI reset. Independent reset is unsupported.
set_false_path -from [get_pins {clocking_unit/pll_mode.pll/LOCK}]
