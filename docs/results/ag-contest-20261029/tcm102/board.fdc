create_clock -name ref_clk -period 37.037037 [get_ports clk_27m]
set_false_path -from [get_ports reset_n]
# UART/LED pads have no synchronous receiver clock. Internal paths stay timed.
set_false_path -to [get_ports {uart_txd led[*]}]
create_generated_clock -name cpu_clk -source [get_ports clk_27m] -multiply_by 34 -divide_by 9 [get_pins {board/clocking_unit/pll_mode.pll/CLKOUT0}]

# MES2L676-100HP, hardware guide V1.2: printed pp.19,39-40,46-47.
# Core-board 27 MHz is D18. Base-board 27 MHz E17 is a different source.
define_attribute {p:clk_27m} {PAP_IO_LOC} {D18}
define_attribute {p:reset_n} {PAP_IO_LOC} {C22}
define_attribute {p:uart_txd} {PAP_IO_LOC} {C24}
define_attribute {p:led[0]} {PAP_IO_LOC} {A20}
define_attribute {p:led[1]} {PAP_IO_LOC} {C18}
define_attribute {p:led[2]} {PAP_IO_LOC} {C19}
define_attribute {p:led[3]} {PAP_IO_LOC} {E18}
define_attribute {p:led[4]} {PAP_IO_LOC} {A17}
define_attribute {p:led[5]} {PAP_IO_LOC} {A18}
define_attribute {p:led[6]} {PAP_IO_LOC} {C17}
define_attribute {p:led[7]} {PAP_IO_LOC} {B17}
foreach port {clk_27m reset_n uart_txd led[0] led[1] led[2] led[3] led[4] led[5] led[6] led[7]} {
    define_attribute p:$port PAP_IO_VCCIO 3.3
    define_attribute p:$port PAP_IO_STANDARD LVCMOS33
}
